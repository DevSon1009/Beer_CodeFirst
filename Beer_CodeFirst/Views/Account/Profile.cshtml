@model Beer_CodeFirst.ModelView.Profile

<h2 class="mb-4 fw-bold">👤 Hồ sơ cá nhân</h2>

<div class="card shadow-sm border-0 p-4" style="max-width:500px">

    <div class="text-center mb-4">

        <div class="avatar-large">
            @Model.Username.Substring(0, 1).ToUpper()
        </div>

        <h4 class="mt-2">@Model.Username</h4>

    </div>

    <div class="mb-3">
        <label class="form-label">Username</label>
        <input class="form-control" value="@Model.Username" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" value="@Model.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Phone</label>
        <input class="form-control" value="@Model.Phone" />
    </div>

    <button class="btn btn-primary w-100">
        💾 Cập nhật
    </button>

</div>