@model Beer_CodeFirst.ModelView.LogionVM

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<body class="bg-light">
    <div class="container vh-100 d-flex justify-content-center align-items-center">
        <div class="card shadow-lg p-4" style="width:400px; border-radius:15px;">
            <h3 class="text-center mb-4 fw-bold">🔐 Login</h3>

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <!-- ValidationSummary sẽ tự động hiển thị tất cả lỗi không gắn với property -->
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    @Html.LabelFor(temp => temp.UserName, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(temp => temp.UserName, new { @class = "form-control form-control-lg", placeholder = "Enter username" })
                    @Html.ValidationMessageFor(temp => temp.UserName, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(temp => temp.Password, new { @class = "form-label fw-bold" })
                    @Html.PasswordFor(temp => temp.Password, new { @class = "form-control form-control-lg", placeholder = "Enter password" })
                    @Html.ValidationMessageFor(temp => temp.Password, "", new { @class = "text-danger" })
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-success btn-lg">Login</button>
                </div>

                <div class="text-center mt-3">
                    <small>
                        Don't have an account?
                        <a href="@Url.Action("Register", "Account")">Register</a>
                    </small>
                </div>
            }
        </div>
    </div>
</body>