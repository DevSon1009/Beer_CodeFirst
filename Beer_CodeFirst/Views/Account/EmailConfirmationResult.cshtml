@{
    ViewBag.Title = "Kết quả xác nhận email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 50px; margin-bottom: 50px;">
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger text-center">
            <h2>❌ Xác nhận thất bại!</h2>
            <p style="font-size: 16px; margin-top: 20px;">@ViewBag.Error</p>
            <div class="mt-4">
                <a href="@Url.Action("Register", "Account")" class="btn btn-primary">Đăng ký lại</a>
                <a href="@Url.Action("Login", "Account")" class="btn btn-default">Quay lại đăng nhập</a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success text-center">
            <h2>✅ @ViewBag.Message</h2>
            <p style="font-size: 16px; margin-top: 20px;">
                Chúc mừng! Tài khoản của bạn đã được kích hoạt thành công.
            </p>
            <p>Bạn có thể đăng nhập để trải nghiệm các tính năng của Beer Shop.</p>
            <a href="@Url.Action("Login", "Account")" class="btn btn-success btn-lg" style="margin-top: 20px;">
                Đăng nhập ngay
            </a>
        </div>
    }
</div>