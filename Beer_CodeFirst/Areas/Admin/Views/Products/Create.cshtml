@model Beer_CodeFirst.Models.Product


    <h2 class="mb-4 fw-bold">➕ Thêm sản phẩm mới</h2>

    @using (Html.BeginForm("Create", "Products", new { area ="Admin" }, FormMethod.Post, new {enctype="multipart/dorm-data"}))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="card shadow-sm border-0 p-4">

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Tên sản phẩm</label>
                    @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Danh mục</label>
                    @Html.DropDownListFor(model => model.CategoryId,
         (SelectList)ViewBag.CategoryList,
         "-- Chọn danh mục --",
         new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Giá bán</label>
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", required = "required", min = "0" })
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Giá gốc</label>
                    @Html.TextBoxFor(m => m.OriginalPrice, new { @class = "form-control", type = "number", min = "0" })
                    @Html.ValidationMessageFor(m => m.OriginalPrice, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Tồn kho</label>
                    @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control", type = "number", min = "0" })
                    @Html.ValidationMessageFor(m => m.StockQuantity, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Nồng độ cồn (%)</label>
                    @Html.TextBoxFor(m => m.AlcoholContent, new { @class = "form-control", type = "number", step = "0.1", min = "0", max = "100" })
                    @Html.ValidationMessageFor(m => m.AlcoholContent, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Dung tích (ml)</label>
                    @Html.TextBoxFor(m => m.Volume, new { @class = "form-control", type = "number", min = "0" })
                    @Html.ValidationMessageFor(m => m.Volume, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Xuất xứ</label>
                    @Html.TextBoxFor(m => m.Origin, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Origin, "", new { @class = "text-danger" })
                </div>

                <div class="col-12">
                    <label class="form-label">Link ảnh</label>
                    @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", type = "url" })
                    @Html.ValidationMessageFor(m => m.ImageUrl, "", new { @class = "text-danger" })
                </div>

                <div class="col-12">
                    <label class="form-label">Mô tả</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </div>

                <div class="col-12 form-check mt-3">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    <label class="form-check-label">Kích hoạt sản phẩm</label>
                </div>

            </div>

            <div class="mt-4 d-flex gap-3">
                <button type="submit" class="btn btn-primary px-4">
                    💾 Lưu sản phẩm
                </button>

                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    ← Quay lại
                </a>
            </div>

        </div>
    }
