@model Beer_CodeFirst.Models.Product



<div class="container mt-5">
    <div class="card shadow rounded-4 border-0">

        <div class="card-header bg-danger text-white rounded-top-4">
            <h4 class="mb-0">⚠ Xác nhận xóa sản phẩm</h4>
        </div>

        <div class="card-body p-4">

            <p class="text-danger fw-bold">
                Bạn có chắc chắn muốn xóa sản phẩm này không?
            </p>

            <form method="post">

                <!-- Gửi id lên POST -->
                <input type="hidden" name="id" value="@Model.ProductId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Mã sản phẩm</label>
                    <input type="text" class="form-control"
                           value="@Model.ProductId" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên sản phẩm</label>
                    <input type="text" class="form-control"
                           value="@Model.ProductName" readonly />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Giá</label>
                    <input type="text"
                           class="form-control"
                           value="@Model.Price.Value.ToString("C")"
                           readonly />
                </div>

                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Index")"
                       class="btn btn-outline-secondary px-4">
                        ⬅ Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4">
                        🗑 Delete
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>