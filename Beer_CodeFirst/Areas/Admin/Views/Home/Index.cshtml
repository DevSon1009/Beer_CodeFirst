@{
    ViewBag.Title = "Admin Home";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h2 class="fw-bold">🍺 Welcome Admin</h2>
        <p class="text-muted">Manage your beer store system</p>
    </div>

    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card shadow text-center">
                <div class="card-body">
                    <h5 class="card-title">Products</h5>
                    <p class="card-text">Manage all beer products in the system.</p>
                    <a href="/Admin/Products" class="btn btn-primary">Manage Products</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow text-center">
                <div class="card-body">
                    <h5 class="card-title">Categories</h5>
                    <p class="card-text">Manage beer categories.</p>
                    <a href="/Admin/Categories" class="btn btn-success">Manage Categories</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow text-center">
                <div class="card-body">
                    <h5 class="card-title">Orders</h5>
                    <p class="card-text">View and manage customer orders.</p>
                    <a href="/Admin/Orders" class="btn btn-warning">View Orders</a>
                </div>
            </div>
        </div>

    </div>

</div>